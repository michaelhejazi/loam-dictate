{
  "name": "loam-dictate",
  "version": "0.1.1",
  "description": "Obsidian plugin: record a take, clean it through a Loam UI server, insert it at the cursor.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "tsc -p test && vitest run",
    "fake": "node test/fake-loam.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.19.0",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
