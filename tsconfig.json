{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2020"],
		"strict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"importHelpers": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true
	},
	"include": ["src/**/*.ts"]
}
